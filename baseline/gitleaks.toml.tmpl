# gitleaks configuration for [% .Repo %]: the default rules[% if not .Knobs.GitleaksAllowlist %], nothing
# allowlisted[% end %].
#
# Rendered from blairham/.github baseline/gitleaks.toml.tmpl by `make sync`.
# An allowlist entry is an override (overrides/[% .Repo %].yml) and carries the
# reason it is not a secret. Allowlist exact values, never a broad pattern: a
# wildcard silences the rule that exists to catch a genuine key.

[extend]
useDefault = true
[%- if .Knobs.GitleaksAllowlist %]

[% .Knobs.GitleaksAllowlist -%]
[% end %]
