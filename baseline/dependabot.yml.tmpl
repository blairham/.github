# https://docs.github.com/code-security/dependabot/dependabot-version-updates/configuration-options-for-the-dependabot.yml-file
#
# Rendered from blairham/.github baseline/dependabot.yml.tmpl by `make sync`.
# Groups are derived from go.mod: a group appears when the module requires
# something it covers. The docker ecosystem appears when there is a Dockerfile.
version: 2
updates:
  - package-ecosystem: gomod
    directory: /
    schedule:
      interval: monthly
    open-pull-requests-limit: 10
[%- if .DependabotGroups %]
    groups:
[%- range .DependabotGroups %]
[% comment 6 .Comment %]
      [% .Name %]:
        patterns:
[%- range .Patterns %]
          - "[% . %]"
[%- end %]
[%- end %]
[%- end %]
  # Bumps the SHA pins and their `# vX.Y.Z` comments together, including the
  # pin on blairham/.github's reusable workflows.
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: monthly
    groups:
      # CodeQL refuses to run when its init, autobuild, analyze and
      # upload-sarif steps are at different versions; split, every bump fails
      # Analyze.
      codeql-action:
        patterns:
          - "github/codeql-action*"
      # Every reusable workflow (go-ci, go-changes, go-release, go-image,
      # go-chart) is pinned at the same blairham/.github tag, and drift wants
      # all of them on the latest. Each path is its own dependency, so split,
      # a tag arrives as one PR per workflow, and the strict ruleset makes each
      # wait for a rebase after the one before it lands.
      blairham-github:
        patterns:
          - "blairham/.github/*"
[%- if .HasDockerfile %]
  - package-ecosystem: docker
    directory: /
    schedule:
      interval: monthly
    ignore:
      # A Go minor bump moves go.mod and .tool-versions by hand, not as a lone
      # Dockerfile bump. Digest and patch updates still come through.
      - dependency-name: [% .DockerGolangName %]
        update-types:
          - version-update:semver-major
          - version-update:semver-minor
[%- range .Knobs.DependabotDockerIgnore %]
[% comment 6 .Reason %]
      - dependency-name: [% .DependencyName %]
        update-types:
[%- range .UpdateTypes %]
          - [% . %]
[%- end %]
[%- end %]
[%- end %]
